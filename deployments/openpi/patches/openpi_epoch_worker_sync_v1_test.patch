+@pytest.mark.parametrize("num_workers", (1, 2, 4))
+def test_torch_data_loader_persistent_workers_refresh_epoch(num_workers: int) -> None:
+    dataset = _EpochProbeDataset()
+    transform = _EpochProbeTransform()
+    loader = _data_loader.TorchDataLoader(
+        _data_loader.TransformedDataset(dataset, [transform]),
+        local_batch_size=2,
+        num_batches=4,
+        num_workers=num_workers,
+        framework="pytorch",
+    )
+
+    batches = list(loader)
+    base_epochs = [int(value) for batch in batches for value in batch["base_epoch"].tolist()]
+    transform_epochs = [int(value) for batch in batches for value in batch["transform_epoch"].tolist()]
+
+    assert base_epochs == [0, 0, 1, 1]
+    assert transform_epochs == [0, 0, 1, 1]
+    assert loader._epoch_worker_mode == "shared_epoch_v1"
+
