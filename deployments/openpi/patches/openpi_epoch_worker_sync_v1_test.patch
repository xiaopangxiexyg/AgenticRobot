 from openpi.training import data_loader as _data_loader
 
 
+class _EpochProbeDataset:
+    def __init__(self) -> None:
+        self.epoch = 0
+
+    def __len__(self) -> int:
+        return 4
+
+    def __getitem__(self, index: int) -> dict[str, np.ndarray]:
+        return {
+            "base_epoch": np.asarray(self.epoch, dtype=np.int64),
+            "index": np.asarray(index, dtype=np.int64),
+        }
+
+    def set_epoch(self, epoch: int) -> None:
+        self.epoch = int(epoch)
+
+
+class _EpochProbeTransform:
+    def __init__(self) -> None:
+        self.epoch = 0
+
+    def __call__(self, data: dict[str, np.ndarray]) -> dict[str, np.ndarray]:
+        return {
+            **data,
+            "transform_epoch": np.asarray(self.epoch, dtype=np.int64),
+        }
+
+    def set_epoch(self, epoch: int) -> None:
+        self.epoch = int(epoch)
+
