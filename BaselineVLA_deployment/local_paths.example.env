# Copy this file to local_paths.env and adjust machine-local absolute paths.
# local_paths.env is intentionally ignored by git.

# Runtime environment.
CONDA_ENV=ManipRep_310
# CONDA_SH=$HOME/anaconda3/etc/profile.d/conda.sh
# PYTHON_BIN=python

# Optional external dataset roots. Leave unset to use repo-relative Data/... paths.
# MANIPREP_REALROBOT_CHIPS_ROOT=/abs/path/to/realrobot/chips_med
# MANIPREP_REALROBOT_PAPER_FOLD_ROOT=/abs/path/to/realrobot/paper_fold_datasets
# MANIPREP_REALROBOT_HEAVY_LIGHT_ROOT=/abs/path/to/realrobot/2026-04-30_heavy_light
# MANIPREP_RAWHAND_POINT_ROOT=/abs/path/to/RawHandPointData
# MANIPREP_DESKTASK_RAWHAND_ROOT=/abs/path/to/DeskTaskTacRawHand
# MANIPREP_DESKTASK_APRILTAG_ROOT=/abs/path/to/DeskTaskAprilTag
# MANIPREP_HUMANMIX_ROOT=/abs/path/to/HumanMix

# Optional deployment package root for PolicyDeploy/Model_FR3_deploy/*.sh.
# MANIPREP_DEPLOY_PACKAGE_ROOT=/abs/path/to/dex_inspire_teleop_new

# Optional local cache/config paths.
# MPLCONFIGDIR=/tmp/maniprep_matplotlib
