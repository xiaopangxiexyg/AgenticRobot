{
  "suite_name": "humanmix_vla_action_history_grid",
  "description": "HumanMix VLA action-chunk/history validation grid. Runs Vanilla-tactile VLA first, then FullTrain VLA. Tactile input is vector-only; no point-cloud input is used.",
  "entrypoint": "Training/train.py",
  "base_config": "train_runner",
  "analysis_target": "evaluation_val_action_rmse",
  "runner": {
    "skip_existing": true,
    "fail_fast": false,
    "retry_on_resource_failure": true,
    "subprocess_timeout_sec": 7200,
    "sleep_between_attempts_sec": 3.0,
    "limit_cpu_thread_env": true
  },
  "evaluation": {
    "enabled": true,
    "script": "TestScripts/evaluate_checkpoint.py",
    "checkpoint_kind": "best",
    "split": "val",
    "loader_mode": "safe",
    "batch_size": 16,
    "num_workers": 0,
    "save_samples": 0,
    "visualize": "none",
    "device": "cuda",
    "output_tag": "grid_eval_val",
    "skip_existing": true
  },
  "defaults": {
    "data_config": "humanmix_real",
    "train_config": "real_debug",
    "shared_overrides": [
      "train.epochs=1",
      "train.device=cuda",
      "train.wandb.enabled=true",
      "train.wandb.mode=offline",
      "train.validation_ratio=1.0",
      "++data.raw.sampling.sample_ratio=0.2",
      "++data.raw.sampling.sample_seed=7",
      "++data.raw.sampling.min_history_frames=16",
      "++data.raw.sampling.min_future_frames=93",
      "data.raw.sequence.action_stride=3",
      "data.raw.sequence.med.kind=vector",
      "data.raw.sequence.med.side=right",
      "data.raw.sequence.med.intermediate_key=future_right_tactile",
      "data.raw.sequence.med.future_start=1",
      "data.raw.sequence.med.stride=1",
      "data.raw.sequence.med.vector.field=tactile.right_tacglove",
      "data.raw.sequence.med.vector.mask_field=tactile.right_tacglove_mask",
      "data.raw.sequence.med.vector.zero_invalid=true",
      "data.raw.video.enabled=true",
      "data.raw.loader.batch_size=16",
      "data.raw.loader.num_workers=4",
      "data.raw.loader.persistent_workers=false",
      "data.raw.loader.prefetch_factor=1",
      "data.raw.loader.val.num_workers=2",
      "data.raw.loader.val.persistent_workers=false",
      "data.raw.loader.val.prefetch_factor=1"
    ]
  },
  "seeds": [
    7
  ],
  "datasets": [
    {
      "id": "humanmix",
      "label": "HumanMix",
      "root_dir": "Data/RawData/Human/HumanMix",
      "dataset_name_filter": "HumanMix",
      "extra_overrides": []
    }
  ],
