{
  "suite_name": "rawhand_phase_s1_screening",
  "description": "Phase S1 screening for RawHand tactile intermediate representations. Uses a shared Vanilla-MLP baseline plus six GTMed-MLP candidates on vector and point-cloud MED under a sample-capped 2-epoch budget.",
  "entrypoint": "Training/train.py",
  "base_config": "train_runner",
  "analysis_target": "evaluation_val_action_rmse",
  "runner": {
    "skip_existing": true,
    "fail_fast": false,
    "retry_on_resource_failure": true,
    "subprocess_timeout_sec": 7200,
    "sleep_between_attempts_sec": 3.0,
    "limit_cpu_thread_env": true
  },
  "evaluation": {
    "enabled": true,
    "script": "TestScripts/evaluate_checkpoint.py",
    "checkpoint_kind": "best",
    "split": "val",
    "loader_mode": "safe",
    "batch_size": 32,
    "num_workers": 0,
    "save_samples": 0,
    "visualize": "none",
    "device": "cuda",
    "output_tag": "phase_s1_eval_val",
    "skip_existing": true
  },
  "defaults": {
    "data_config": "desktasktac_rawhand_point_real",
    "train_config": "real_debug",
    "shared_overrides": [
      "train.epochs=2",
      "train.device=cuda",
      "train.wandb.enabled=true",
      "train.wandb.mode=offline",
      "train.validation_ratio=1.0",
      "data.raw.loader.batch_size=64",
      "data.raw.loader.num_workers=4",
      "data.raw.loader.persistent_workers=false",
      "data.raw.loader.prefetch_factor=2",
      "data.raw.loader.val.num_workers=4",
      "data.raw.loader.val.persistent_workers=false",
      "data.raw.loader.val.prefetch_factor=2",
      "++data.raw.limits.max_datasets=1",
      "++data.raw.limits.max_episodes_per_dataset=64",
      "++data.raw.limits.max_frames_per_episode=16",
      "++data.raw.limits.max_total_samples=1024"
    ]
  },
  "seeds": [
    7
  ],
  "datasets": [
    {
      "id": "rawhand_point",
      "label": "RawHandPointData",
      "root_dir": "Data/RawData/Human/RawHandPointData",
      "dataset_name_filter": "RawHandPointData",
      "extra_overrides": []
    }
  ],
  "med_targets": [
    {
      "id": "vec_f1_4",
      "label": "Vector future[1,4]",
      "extra_overrides": [
        "data.raw.sequence.med.kind=vector",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_tactile",
        "data.raw.sequence.med.future_start=1",
        "data.raw.sequence.med.future_end=4",
        "data.raw.sequence.med.stride=1",
        "data.raw.sequence.med.vector.field=tactile.right_tacglove",
        "data.med.flatten_sequence=auto",
        "model.med_branch.projector.type=mlp"
      ]
    },
    {
      "id": "vec_f1_8",
      "label": "Vector future[1,8]",
      "extra_overrides": [
        "data.raw.sequence.med.kind=vector",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_tactile",
        "data.raw.sequence.med.future_start=1",
        "data.raw.sequence.med.future_end=8",
        "data.raw.sequence.med.stride=1",
        "data.raw.sequence.med.vector.field=tactile.right_tacglove",
        "data.med.flatten_sequence=auto",
        "model.med_branch.projector.type=mlp"
      ]
    },
    {
      "id": "pc_f1_4_mlp",
      "label": "PointCloud future[1,4] MLP",
      "extra_overrides": [
        "data.raw.sequence.med.kind=point_cloud",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_point_cloud",
        "data.raw.sequence.med.future_start=1",
        "data.raw.sequence.med.future_end=4",
        "data.raw.sequence.med.stride=1",
        "data.med.flatten_sequence=auto",
        "model.med_branch.projector.type=mlp"
      ]
    },
    {
      "id": "pc_f1_8_mlp",
      "label": "PointCloud future[1,8] MLP",
      "extra_overrides": [
        "data.raw.sequence.med.kind=point_cloud",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_point_cloud",
        "data.raw.sequence.med.future_start=1",
        "data.raw.sequence.med.future_end=8",
        "data.raw.sequence.med.stride=1",
        "data.med.flatten_sequence=auto",
        "model.med_branch.projector.type=mlp"
      ]
    },
    {
      "id": "pc_f1_4_pn",
      "label": "PointCloud future[1,4] PointNet",
      "extra_overrides": [
        "data.raw.sequence.med.kind=point_cloud",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_point_cloud",
        "data.raw.sequence.med.future_start=1",
        "data.raw.sequence.med.future_end=4",
        "data.raw.sequence.med.stride=1",
        "data.med.flatten_sequence=auto",
        "model.med_branch.projector.type=pointnet"
      ]
    },
    {
      "id": "pc_f1_8_pn",
      "label": "PointCloud future[1,8] PointNet",
      "extra_overrides": [
        "data.raw.sequence.med.kind=point_cloud",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_point_cloud",
        "data.raw.sequence.med.future_start=1",
        "data.raw.sequence.med.future_end=8",
        "data.raw.sequence.med.stride=1",
        "data.med.flatten_sequence=auto",
        "model.med_branch.projector.type=pointnet"
      ]
    }
  ],
  "methods": [
    {
      "id": "vanilla_mlp",
      "label": "Vanilla-MLP",
      "method_kind": "vanilla",
      "experiment": "vanilla",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": false,
      "use_med_target": false,
      "run_name_override": "rawhand_phase_s1_shared_vanilla_mlp_seed{seed}",
      "extra_overrides": []
    },
    {
      "id": "gtmed_mlp",
      "label": "GTMed-MLP",
      "method_kind": "gtmed",
      "experiment": "gtmed",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": false,
      "use_med_target": true,
      "extra_overrides": []
    }
  ]
}
