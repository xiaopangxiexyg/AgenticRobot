{
  "suite_name": "rawhand_explainable_point_cloud",
  "description": "Explainable RawHandPointData suite using Minimal-MLP on point-cloud MED. Includes shared Vanilla, GTMed, and GenMed plus a short post-train validation preview.",
  "entrypoint": "Training/train.py",
  "base_config": "train_runner",
  "analysis_target": "best_val_total_loss",
  "runner": {
    "skip_existing": true,
    "fail_fast": false,
    "retry_on_resource_failure": true,
    "sleep_between_attempts_sec": 3.0,
    "limit_cpu_thread_env": true
  },
  "evaluation": {
    "enabled": true,
    "script": "TestScripts/evaluate_checkpoint.py",
    "checkpoint_kind": "best",
    "split": "val",
    "loader_mode": "safe",
    "visualize": "all",
    "max_batches": 4,
    "save_samples": 1,
    "sample_index": 0,
    "max_points": 256,
    "device": "cuda",
    "output_tag": "suite_eval_val",
    "skip_existing": true
  },
  "defaults": {
    "data_config": "desktasktac_rawhand_point_real",
    "train_config": "real_debug",
    "shared_overrides": [
      "train.epochs=2",
      "train.device=cuda",
      "train.wandb.enabled=true",
      "train.validation_ratio=0.1"
    ]
  },
  "seeds": [
    7
  ],
  "datasets": [
    {
      "id": "rawhand_point",
      "label": "RawHandPointData",
      "root_dir": "Data/RawData/Human/RawHandPointData",
      "dataset_name_filter": "RawHandPointData",
      "extra_overrides": []
    }
  ],
  "med_targets": [
    {
      "id": "right_point_cloud",
      "label": "Right Tactile Point Cloud",
      "extra_overrides": [
        "data.raw.sequence.med.kind=point_cloud",
        "data.raw.sequence.med.side=right",
        "data.raw.sequence.med.intermediate_key=future_right_point_cloud",
        "data.med.flatten_sequence=auto"
      ]
    }
  ],
  "methods": [
    {
      "id": "genmed_mlp",
      "label": "GenMed-MLP",
      "method_kind": "genmed",
      "experiment": "genmed",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": false,
      "use_med_target": true,
      "extra_overrides": [
        "model.med_branch.predictor.type=mlp"
      ]
    },
    {
      "id": "gtmed_mlp",
      "label": "GTMed-MLP",
      "method_kind": "gtmed",
      "experiment": "gtmed",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": false,
      "use_med_target": true,
      "extra_overrides": [
        "model.med_branch.projector.type=mlp"
      ]
    },
    {
      "id": "vanilla_mlp",
      "label": "Vanilla-MLP",
      "method_kind": "vanilla",
      "experiment": "vanilla",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": false,
      "use_med_target": false,
      "run_name_override": "rawhand_explainable_shared_vanilla_mlp_seed{seed}",
      "extra_overrides": []
    }
  ]
}
