{
  "suite_name": "future_tactile_full",
  "description": "Full comparison suite with two seeds for shortlisted future tactile windows.",
  "entrypoint": "Training/train.py",
  "base_config": "train_runner",
  "analysis_target": "best_val_action_loss",
  "runner": {
    "skip_existing": true,
    "fail_fast": false,
    "retry_on_resource_failure": true,
    "subprocess_timeout_sec": 14400,
    "sleep_between_attempts_sec": 5.0,
    "limit_cpu_thread_env": true
  },
  "defaults": {
    "data_config": "desktasktac_real",
    "train_config": "real_debug",
    "shared_overrides": [
      "data.raw.derived_val_ratio=0.3",
      "data.raw.limits.max_episodes_per_dataset=128",
      "data.raw.limits.max_frames_per_episode=24",
      "data.raw.limits.max_total_samples=4096",
      "data.raw.loader.batch_size=4",
      "data.raw.sequence.action_chunk=8",
      "data.raw.sequence.med_stride=1",
      "data.raw.video.enabled=true",
      "train.epochs=6",
      "train.wandb.enabled=true",
      "train.wandb.mode=online",
      "train.device=cuda:0"
    ]
  },
  "seeds": [
    7,
    17
  ],
  "datasets": [
    {
      "id": "rawhand",
      "label": "DeskTaskTacRawHand",
      "root_dir": "Data/RawData/Human/DeskTaskTacRawHand",
      "dataset_name_filter": "DeskTaskTacRawHand",
      "extra_overrides": []
    },
    {
      "id": "apriltag",
      "label": "DeskTaskAprilTag",
      "root_dir": "Data/RawData/Human/DeskTaskAprilTag",
      "dataset_name_filter": "DeskTaskTacAprilTag",
      "extra_overrides": []
    }
  ],
  "vanilla_methods": [
    {
      "id": "mlp",
      "label": "Vanilla-MLP",
      "experiment": "vanilla",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": true,
      "extra_overrides": []
    },
    {
      "id": "vla",
      "label": "Vanilla-VLA",
      "experiment": "vanilla",
      "model": "basic_vla",
      "family": "vla",
      "task_enabled": true,
      "extra_overrides": []
    },
    {
      "id": "dp",
      "label": "Vanilla-DP",
      "experiment": "vanilla",
      "model": "basic_diffusion",
      "family": "diffusion",
      "task_enabled": true,
      "extra_overrides": []
    }
  ],
  "gtmed_methods": [
    {
      "id": "mlp",
      "label": "GTMed-MLP",
      "experiment": "gtmed",
      "model": "minimal_mlp",
      "family": "mlp",
      "task_enabled": true,
      "extra_overrides": []
    },
    {
      "id": "vla",
      "label": "GTMed-VLA",
      "experiment": "gtmed",
      "model": "basic_vla",
      "family": "vla",
      "task_enabled": true,
      "extra_overrides": []
    },
    {
      "id": "dp",
      "label": "GTMed-DP",
      "experiment": "gtmed",
      "model": "basic_diffusion",
      "family": "diffusion",
      "task_enabled": true,
      "extra_overrides": []
    }
  ],
  "med_windows": [
    {
      "id": "f1_1",
      "label": "future[1,1]",
      "med_future_start": 1,
      "med_future_end": 1,
      "med_stride": 1
    },
    {
      "id": "f1_2",
      "label": "future[1,2]",
      "med_future_start": 1,
      "med_future_end": 2,
      "med_stride": 1
    },
    {
      "id": "f1_4",
      "label": "future[1,4]",
      "med_future_start": 1,
      "med_future_end": 4,
      "med_stride": 1
    },
    {
      "id": "f1_8",
      "label": "future[1,8]",
      "med_future_start": 1,
      "med_future_end": 8,
      "med_stride": 1
    },
    {
      "id": "f4_8",
      "label": "future[4,8]",
      "med_future_start": 4,
      "med_future_end": 8,
      "med_stride": 1
    }
  ]
}
